diff --git a/include/rex/platform/fpscr.h b/include/rex/platform/fpscr.h
index c2c4fd4..81c12ba 100644
--- a/include/rex/platform/fpscr.h
+++ b/include/rex/platform/fpscr.h
@@ -82,8 +82,31 @@ struct FPSCRPlatform {
   }
 };
 
-#else
-#error "Missing implementation for FPSCR."
-#endif
+#elif defined(__wasm32__) || defined(__EMSCRIPTEN__)
+// WebAssembly has no FP control register; rounding/exception control is
+// emulated in a thread-local CSR. NOTE: writes do NOT affect native wasm
+// f32/f64 ops (round-to-nearest always) — PPC sequences that switch rounding
+// modes will compute slightly differently. Tracked Phase-2 risk.
+struct FPSCRPlatform {
+  static constexpr size_t RoundShift = 13;
+  static constexpr size_t RoundMaskVal = 0x6000;
+  static constexpr size_t FlushMask = 0x8040;
+  // Exception mask bits (1 = exception masked/disabled)
+  static constexpr u32 ExceptionMask = (1u << 7) | (1u << 8) | (1u << 9) | (1u << 10) |
+                                       (1u << 11) | (1u << 12);
+  static constexpr size_t GuestToHost[] = {0x0000, 0x6000, 0x2000, 0x4000};
+
+  static inline u32 getcsr() noexcept;
+  static inline void setcsr(u32 csr) noexcept;
+
+  static inline void InitHostExceptions(u32& csr) noexcept {
+    csr |= ExceptionMask;  // Set mask bits to disable exceptions
+  }
+};
+
+inline thread_local u32 g_wasm_soft_csr = 0x1F80;
+inline u32 FPSCRPlatform::getcsr() noexcept { return g_wasm_soft_csr; }
+inline void FPSCRPlatform::setcsr(u32 csr) noexcept { g_wasm_soft_csr = csr; }
+#endif  // __wasm32__ || __EMSCRIPTEN__
 
 }  // namespace rex::platform
