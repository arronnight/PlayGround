diff --git a/include/rex/chrono/chrono.h b/include/rex/chrono/chrono.h
index 8761cff..da5406c 100644
--- a/include/rex/chrono/chrono.h
+++ b/include/rex/chrono/chrono.h
@@ -116,6 +116,21 @@ using XSystemClock = detail::NtSystemClock<detail::Domain::Guest>;
 
 namespace std::chrono {
 
+// libc++ (Emscripten, and any libc++ build) never implemented clock_time_cast,
+// so the primary template does not exist there. libstdc++/MSVC provide it.
+// Declare it for libc++ only; defining it twice would be an error.
+#if defined(_LIBCPP_VERSION)
+template <class Dest, class Source>
+struct clock_time_conversion {};
+
+// libc++ never implemented clock_time_cast/clock_cast; implement it in terms
+// of the conversion trait, mirroring [time.clock.cast].
+template <class Dest, class Source, class Duration>
+constexpr auto clock_cast(const std::chrono::time_point<Source, Duration>& t) {
+  return clock_time_conversion<Dest, Source>{}(t);
+}
+#endif
+
 template <>
 struct clock_time_conversion<::rex::chrono::WinSystemClock, ::rex::chrono::XSystemClock> {
   using WClock_ = ::rex::chrono::WinSystemClock;
