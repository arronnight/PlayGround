diff --git a/src/system/CMakeLists.txt b/src/system/CMakeLists.txt
index 3cb2df6..1d844fd 100644
--- a/src/system/CMakeLists.txt
+++ b/src/system/CMakeLists.txt
@@ -44,7 +44,13 @@ set(REXSYSTEM_SOURCES
     xex_module.cpp
 )
 
-add_library(rexruntime SHARED ${REXSYSTEM_SOURCES})
+if(EMSCRIPTEN)
+    # Static link for wasm (Emscripten dynamic linking is SIDE_MODULE-based;
+    # the headless port links the runtime into the app module).
+    add_library(rexruntime STATIC ${REXSYSTEM_SOURCES})
+else()
+    add_library(rexruntime SHARED ${REXSYSTEM_SOURCES})
+endif()
 add_library(rex::runtime ALIAS rexruntime)
 add_library(rex::system ALIAS rexruntime)
 add_library(rex::kernel ALIAS rexruntime)
diff --git a/thirdparty/CMakeLists.txt b/thirdparty/CMakeLists.txt
index f2dbe79..a9da921 100644
--- a/thirdparty/CMakeLists.txt
+++ b/thirdparty/CMakeLists.txt
@@ -31,8 +31,14 @@ set(REQUIRED_SUBMODULES
     snappy
     utfcpp
     imgui
-    sdl3
 )
+# SDL3 comes from the Emscripten port (-sUSE_SDL=3), FFmpeg (XMA decode) has no
+# Emscripten build — the XMA decoder is stubbed (src/audio/xma_decoder_null.cpp).
+if(EMSCRIPTEN)
+    list(REMOVE_ITEM REQUIRED_SUBMODULES FFmpeg)
+else()
+    list(APPEND REQUIRED_SUBMODULES sdl3)
+endif()
 
 if(REXGLUE_USE_VULKAN)
     list(APPEND REQUIRED_SUBMODULES
@@ -261,7 +267,7 @@ set(SDL_DUMMYAUDIO OFF CACHE BOOL "" FORCE)
 set(SDL_DUMMYVIDEO OFF CACHE BOOL "" FORCE)
 
 # Linux audio backends
-if(UNIX AND NOT APPLE)
+if(UNIX AND NOT APPLE AND NOT EMSCRIPTEN)
     set(SDL_ALSA              ON  CACHE BOOL "" FORCE)
     set(SDL_ALSA_SHARED       ON  CACHE BOOL "" FORCE)
     set(SDL_PULSEAUDIO        ON  CACHE BOOL "" FORCE)
@@ -270,7 +276,16 @@ if(UNIX AND NOT APPLE)
     set(SDL_PIPEWIRE_SHARED   ON  CACHE BOOL "" FORCE)
 endif()
 
-add_subdirectory(sdl3)
+if(EMSCRIPTEN)
+    # SDL3 comes from the Emscripten port (-sUSE_SDL=3): no vendored build.
+    # SDL3::SDL3 carries the port flags to all dependents (rexaudio/rexinput).
+    add_library(SDL3_SDL INTERFACE)
+    add_library(SDL3::SDL3 ALIAS SDL3_SDL)
+    target_compile_options(SDL3_SDL INTERFACE -sUSE_SDL=3)
+    target_link_options(SDL3_SDL INTERFACE -sUSE_SDL=3)
+else()
+    add_subdirectory(sdl3)
+endif()
 
 #=============================================================================
 # DXC API headers (vendored from DirectXShaderCompiler, runtime-loaded)
@@ -378,7 +393,9 @@ endif()
 #=============================================================================
 # FFmpeg - Audio/video codec library (for XMA decoding)
 # Only builds libavutil and libavcodec needed for WMA Pro decoding
+# Skipped on Emscripten (no wasm FFmpeg build; XMA decoder is stubbed).
 #=============================================================================
+if(NOT EMSCRIPTEN)
 
 set(FFMPEG_DIR "${CMAKE_CURRENT_SOURCE_DIR}/FFmpeg")
 
@@ -674,3 +691,5 @@ set_target_properties(libavutil libavcodec PROPERTIES
     C_VISIBILITY_PRESET hidden
     VISIBILITY_INLINES_HIDDEN ON
     FOLDER "FFmpeg")
+
+endif()  # NOT EMSCRIPTEN (FFmpeg)
