+++ b/src/audio/xma_context_null.cpp
@@ -0,0 +1,85 @@
+/**
+ * @file        audio/xma_context_null.cpp
+ * @brief       Emscripten stub for the XMA context (no FFmpeg on wasm)
+ *
+ * Phase 1b wasm port. Implements rex::audio::XmaContext as no-ops so
+ * rexaudio links without libavcodec/libavutil. Only constructed (never
+ * driven) by xma_decoder_null.cpp. See xma_decoder_null.cpp.
+ */
+
+#include <rex/platform.h>
+#if REX_PLATFORM_EMSCRIPTEN
+
+#include <rex/audio/xma/context.h>
+
+#include <rex/system/xtypes.h>
+
+namespace rex::audio {
+
+const uint32_t XmaContext::kBitsPerPacketHeader;
+const uint32_t XmaContext::kOutputMaxSizeBytes;
+
+XmaContext::XmaContext() = default;
+XmaContext::~XmaContext() = default;
+
+int XmaContext::Setup(uint32_t /*id*/, memory::Memory* /*memory*/, uint32_t /*guest_ptr*/) {
+  return -1;
+}
+bool XmaContext::Work() { return false; }
+
+void XmaContext::Enable() {}
+bool XmaContext::Block(bool /*poll*/) { return false; }
+void XmaContext::Clear() {}
+void XmaContext::Disable() {}
+void XmaContext::Release() {}
+
+void XmaContext::SwapInputBuffer(XMA_CONTEXT_DATA* /*data*/) {}
+int XmaContext::GetSampleRate(int id) { return kIdToSampleRate[id & 3]; }
+int16_t XmaContext::GetPacketNumber(size_t /*size*/, size_t /*bit_offset*/) { return 0; }
+uint32_t XmaContext::GetCurrentInputBufferSize(XMA_CONTEXT_DATA* /*data*/) { return 0; }
+
+kPacketInfo XmaContext::GetPacketInfo(uint8_t* /*packet*/, uint32_t /*frame_offset*/) {
+  return kPacketInfo{};
+}
+uint32_t XmaContext::GetAmountOfBitsToRead(uint32_t /*remaining_stream_bits*/,
+                                           uint32_t /*frame_size*/) {
+  return 0;
+}
+const uint8_t* XmaContext::GetNextPacket(XMA_CONTEXT_DATA* /*data*/,
+                                         uint32_t /*next_packet_index*/,
+                                         uint32_t /*current_input_packet_count*/) {
+  return nullptr;
+}
+uint32_t XmaContext::GetNextPacketReadOffset(uint8_t* /*buffer*/,
+                                             uint32_t /*next_packet_index*/,
+                                             uint32_t /*current_input_packet_count*/) {
+  return 0;
+}
+uint8_t* XmaContext::GetCurrentInputBuffer(XMA_CONTEXT_DATA* /*data*/) { return nullptr; }
+
+void XmaContext::Decode(XMA_CONTEXT_DATA* /*data*/) {}
+void XmaContext::Consume(memory::RingBuffer* /*output_rb*/, const XMA_CONTEXT_DATA* /*data*/) {}
+void XmaContext::UpdateLoopStatus(XMA_CONTEXT_DATA* /*data*/) {}
+void XmaContext::ClearLocked(XMA_CONTEXT_DATA* /*data*/) {}
+
+memory::RingBuffer XmaContext::PrepareOutputRingBuffer(XMA_CONTEXT_DATA* /*data*/) {
+  static uint8_t dummy[64] = {};
+  return memory::RingBuffer(dummy, sizeof(dummy));
+}
+int XmaContext::PrepareDecoder(int /*sample_rate*/, bool /*is_two_channel*/) { return -1; }
+void XmaContext::PreparePacket(uint32_t /*frame_size*/, uint32_t /*frame_padding*/) {}
+bool XmaContext::DecodePacket(AVCodecContext* /*av_context*/, const AVPacket* /*av_packet*/,
+                              AVFrame* /*av_frame*/) {
+  return false;
+}
+
+void XmaContext::StoreContextMerged(const XMA_CONTEXT_DATA& /*data*/,
+                                    const XMA_CONTEXT_DATA& /*initial_data*/,
+                                    uint8_t* /*context_ptr*/) {}
+
+void XmaContext::ConvertFrame(const uint8_t** /*samples*/, bool /*is_two_channel*/,
+                              uint8_t* /*output_buffer*/) {}
+
+}  // namespace rex::audio
+
+#endif  // REX_PLATFORM_EMSCRIPTEN
diff --git a/src/audio/xma_decoder_null.cpp b/src/audio/xma_decoder_null.cpp
new file mode 100644
index 0000000..9288111
--- /dev/null
+++ b/src/audio/xma_decoder_null.cpp
@@ -0,0 +1,46 @@
+/**
+ * @file        audio/xma_decoder_null.cpp
+ * @brief       Emscripten stub for the XMA audio decoder (no FFmpeg on wasm)
+ *
+ * Phase 1b wasm port. Implements the rex::audio::XmaDecoder interface as
+ * no-ops so rexaudio links without libavcodec/libavutil. Guest XMA calls get
+ * silent failure (no contexts, no decode). Real XMA decode needs either an
+ * FFmpeg-wasm build or a WebAudio worker — Phase 2+ work.
+ */
+
+#include <rex/platform.h>
+#if REX_PLATFORM_EMSCRIPTEN
+
+#include <rex/audio/xma/decoder.h>
+
+#include <rex/logging.h>
+#include <rex/system/xtypes.h>
+
+namespace rex::audio {
+
+XmaDecoder::XmaDecoder(runtime::FunctionDispatcher* function_dispatcher)
+    : function_dispatcher_(function_dispatcher) {}
+XmaDecoder::~XmaDecoder() = default;
+
+X_STATUS XmaDecoder::Setup(system::KernelState* /*kernel_state*/) {
+  REXLOG_WARN("XMA decoder is a stub on wasm (no FFmpeg); game audio will be silent");
+  return X_STATUS_SUCCESS;
+}
+
+void XmaDecoder::Shutdown() {}
+
+uint32_t XmaDecoder::AllocateContext() { return 0; }
+void XmaDecoder::ReleaseContext(uint32_t /*guest_ptr*/) {}
+bool XmaDecoder::BlockOnContext(uint32_t /*guest_ptr*/, bool /*poll*/) { return false; }
+
+uint32_t XmaDecoder::ReadRegister(uint32_t /*addr*/) { return 0; }
+void XmaDecoder::WriteRegister(uint32_t /*addr*/, uint32_t /*value*/) {}
+
+void XmaDecoder::Pause() { paused_ = true; }
+void XmaDecoder::Resume() { paused_ = false; }
+
+int XmaDecoder::GetContextId(uint32_t /*guest_ptr*/) { return -1; }
+
+}  // namespace rex::audio
+
+#endif  // REX_PLATFORM_EMSCRIPTEN
