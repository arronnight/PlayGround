@@ -0,0 +1,23 @@
+/**
+ * @file        ui/windowed_app_context_null.cpp
+ * @brief       Headless/Emscripten WindowedAppContext implementation
+ *
+ * Phase 1b wasm port. See include/rex/ui/windowed_app_context_null.h.
+ */
+
+#include <rex/ui/windowed_app_context_null.h>
+
+namespace rex {
+namespace ui {
+
+void NullWindowedAppContext::RunMainNullLoop() {
+  while (!quit_requested_) {
+    ExecutePendingFunctionsFromUIThread();
+    if (HasQuitFromUIThread()) {
+      break;
+    }
+  }
+}
+
+}  // namespace ui
+}  // namespace rex
