+/**
+ * @file        rex/ui/windowed_app_context_null.h
+ * @brief       Headless/Emscripten WindowedAppContext (no OS event loop)
+ *
+ * Phase 1b wasm port. Pumps pending UI-thread functions from an explicit
+ * RunMainNullLoop(); under Emscripten the browser main loop will call
+ * ExecutePendingFunctionsFromUIThread() per frame instead.
+ */
+
+#pragma once
+
+#include <rex/ui/windowed_app_context.h>
+
+namespace rex {
+namespace ui {
+
+class NullWindowedAppContext final : public WindowedAppContext {
+ public:
+  NullWindowedAppContext() = default;
+
+  void NotifyUILoopOfPendingFunctions() override {}
+  void PlatformQuitFromUIThread() override { quit_requested_ = true; }
+
+  // Runs until PlatformQuitFromUIThread. For Emscripten, prefer driving
+  // ExecutePendingFunctionsFromUIThread() from the browser main loop.
+  void RunMainNullLoop();
+
+ private:
+  bool quit_requested_ = false;
+};
+
+}  // namespace ui
+}  // namespace rex
