diff --git a/include/rex/system/xsocket.h b/include/rex/system/xsocket.h
index d5493a7..34ad930 100644
--- a/include/rex/system/xsocket.h
+++ b/include/rex/system/xsocket.h
@@ -71,6 +71,17 @@ class XSocket : public XObject {
  public:
   static const XObject::Type kObjectType = XObject::Type::Socket;
 
+// musl (Emscripten) defines AF_*/SOCK_*/IPPROTO_* as macros while glibc uses
+// enums; undef them so the scoped enumerators below parse regardless of which
+// system headers were included first. (Undefining a non-macro is a no-op, so
+// this is safe on all platforms. TUs that include system socket headers AFTER
+// this header must undef again before use — see src/system/xsocket.cpp.)
+#undef AF_INET
+#undef SOCK_STREAM
+#undef SOCK_DGRAM
+#undef IPPROTO_TCP
+#undef IPPROTO_UDP
+
   enum AddressFamily {
     AF_INET = 2,
   };
