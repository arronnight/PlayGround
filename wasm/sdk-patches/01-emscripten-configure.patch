diff --git a/CMakeLists.txt b/CMakeLists.txt
index 603eb7d..fb1cbd7 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -37,7 +37,7 @@ else()
     option(REXGLUE_USE_VULKAN "Enable Vulkan graphics backend" ON)
 endif()
 
-if(NOT REXGLUE_USE_D3D12 AND NOT REXGLUE_USE_VULKAN)
+if(NOT REXGLUE_USE_D3D12 AND NOT REXGLUE_USE_VULKAN AND NOT EMSCRIPTEN)
     message(FATAL_ERROR "At least one graphics backend must be enabled (REXGLUE_USE_D3D12 or REXGLUE_USE_VULKAN)")
 endif()
 
@@ -74,8 +74,13 @@ if(CMAKE_CXX_COMPILER_VERSION VERSION_LESS "18.0")
     message(FATAL_ERROR "ReXGlue requires Clang 18 or newer (found ${CMAKE_CXX_COMPILER_VERSION})")
 endif()
 
-# Enforce x64 architecture
-if(NOT CMAKE_SIZEOF_VOID_P EQUAL 8)
+# Enforce x64 architecture (wasm32 has 4-byte pointers; allowed for the
+# headless Emscripten build, where guest memory uses a base-offset layer)
+if(EMSCRIPTEN)
+    if(NOT CMAKE_SIZEOF_VOID_P EQUAL 4 AND NOT CMAKE_SIZEOF_VOID_P EQUAL 8)
+        message(FATAL_ERROR "ReXGlue Emscripten build needs 32- or 64-bit pointers")
+    endif()
+elseif(NOT CMAKE_SIZEOF_VOID_P EQUAL 8)
     message(FATAL_ERROR "ReXGlue only supports 64‑bit architectures (x86_64 or ARM64)")
 endif()
 
@@ -83,10 +88,19 @@ endif()
 set(CMAKE_CXX_STANDARD 23)
 set(CMAKE_CXX_STANDARD_REQUIRED ON)
 set(CMAKE_CXX_EXTENSIONS OFF)
+
+if(EMSCRIPTEN)
+    # Threads (std::thread/pthreads) are required by the runtime; objects and
+    # the final link must agree on the atomics/shared-memory target features.
+    # NOTE: serving a threaded wasm build needs COOP/COEP headers for
+    # SharedArrayBuffer (Phase 2 runtime concern, not a link concern).
+    add_compile_options(-pthread)
+    add_link_options(-pthread)
+endif()
 set(CMAKE_DEBUG_POSTFIX d)
 set(CMAKE_RELWITHDEBINFO_POSTFIX rd)
 
-if(NOT WIN32)
+if(NOT WIN32 AND NOT EMSCRIPTEN)
     # Use appropriate code model based on architecture
     if(CMAKE_SYSTEM_PROCESSOR MATCHES "AMD64|x86_64")
         # Large code model on x86_64 for linking with very large recompiled executables (35MB+)
@@ -120,8 +134,10 @@ if(WIN32)
         message(FATAL_ERROR "Unsupported Windows architecture: ${CMAKE_SYSTEM_PROCESSOR}")
     endif()
     add_compile_definitions(REX_PLATFORM_WINDOWS=1)
-elseif(UNIX AND NOT APPLE)
-    if(CMAKE_SYSTEM_PROCESSOR MATCHES "AMD64|x86_64")
+elseif((UNIX AND NOT APPLE) OR EMSCRIPTEN)
+    if(EMSCRIPTEN)
+        set(REX_PLATFORM "wasm32")
+    elseif(CMAKE_SYSTEM_PROCESSOR MATCHES "AMD64|x86_64")
         set(REX_PLATFORM "linux-amd64")
     elseif(CMAKE_SYSTEM_PROCESSOR MATCHES "aarch64|ARM64")
         set(REX_PLATFORM "linux-arm64")
@@ -232,11 +248,13 @@ message(STATUS "  Tracy: ${REXGLUE_ENABLE_TRACY}")
 message(STATUS "  Perf Counters: ${REXGLUE_ENABLE_PERF_COUNTERS}")
 message(STATUS "===========================================")
 
-# SDK install/export rules (skipped when consumed as a subdirectory)
-if(PROJECT_IS_TOP_LEVEL)
+# SDK install/export rules (skipped when consumed as a subdirectory).
+# Skipped on Emscripten too: the wasm port links the runtime in-tree and the
+# export set does not cover the port-provided SDL3 interface target.
+if(PROJECT_IS_TOP_LEVEL AND NOT EMSCRIPTEN)
     include(cmake/rexglue_devenv.cmake)
     include(cmake/rexglue_install.cmake)
-else()
+elseif(NOT PROJECT_IS_TOP_LEVEL)
     # When consumed via add_subdirectory(), provide the same interface as find_package().
     # This sets REXGLUE_SHARE_DIR and makes rexglue_configure_target() available.
     set(REXGLUE_SHARE_DIR "${CMAKE_CURRENT_SOURCE_DIR}/src/ui" PARENT_SCOPE)
